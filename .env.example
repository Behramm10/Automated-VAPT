# =============================================================================
# Agentic AI VAPT Framework — Environment Configuration
# Copy to .env and fill in values. Never commit .env to source control.
# =============================================================================

# Application
APP_ENV=development
APP_NAME="Agentic AI VAPT Framework"
APP_VERSION=1.0.0
SECRET_KEY=change-me-to-a-random-64-char-secret-key
LOG_LEVEL=INFO

# Database (PostgreSQL for production/Docker, SQLite for local dev)
DATABASE_URL=postgresql+asyncpg://vapt:vapt@localhost:5432/vapt
SQLITE_URL=sqlite+aiosqlite:///./vapt.db

# Use SQLite in dev mode (set to false to use PostgreSQL even in dev)
USE_SQLITE=true

# Ollama / Llama 3B (local LLM for report generation and bounded judge)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:3b
OLLAMA_TIMEOUT=120
LLM_ENABLED=true

# Assessment limits
DEFAULT_MAX_TURNS=6
DEFAULT_TIMEOUT_SECONDS=60
DEFAULT_MAX_TOOL_CALLS=20
DEFAULT_MAX_SESSIONS_PER_RUN=50
MAX_PAYLOAD_SIZE_BYTES=65536

# Sandbox
SANDBOX_ENABLED=true
SANDBOX_NETWORK_DISABLED=true
SANDBOX_FIXTURE_DIR=./sandbox/fixtures
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_EXEC_TIMEOUT=30

# Real target mode (disabled by default — requires explicit authorization)
REAL_TARGET_MODE=false

# Rate limiting (per-target)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_RUNS_PER_HOUR=10

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# Frontend URL (for links in reports)
FRONTEND_URL=http://localhost:5173

# Report output directory
REPORTS_DIR=./reports

# Evidence storage
EVIDENCE_DIR=./evidence

# API keys (optional — only for non-mock adapters)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# Observability (optional OpenTelemetry)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
